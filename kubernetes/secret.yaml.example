# Do NOT commit a real secret.yaml (it is gitignored). Preferred: create it imperatively:
#   kubectl -n mg-platform create secret generic mg-platform-db \
#     --from-literal=MYSQL_ROOT_PASSWORD='<root-password>' \
#     --from-literal=MYSQL_PASSWORD='<app-password>'
# Or copy this file to secret.yaml, replace the placeholders, and apply it.
apiVersion: v1
kind: Secret
metadata:
  name: mg-platform-db
  namespace: mg-platform
type: Opaque
stringData:
  MYSQL_ROOT_PASSWORD: "REPLACE_ME"
  MYSQL_PASSWORD: "REPLACE_ME"
